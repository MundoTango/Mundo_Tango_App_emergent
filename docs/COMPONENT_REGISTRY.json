{
  "$schema": "Component Registry - Canonical Import Paths",
  "version": "1.0.0",
  "created": "2025-10-20",
  "purpose": "Prevent duplicate components and enforce single source of truth",
  
  "canonical_components": {
    "Sidebar": {
      "path": "@/components/layout/sidebar",
      "file": "client/src/components/layout/sidebar.tsx",
      "status": "active",
      "design": "Aurora Tide (cyan/turquoise gradients)",
      "deprecated_paths": [
        "@/components/Sidebar"
      ]
    },
    "TopBar": {
      "path": "@/components/navigation/UnifiedTopBar",
      "file": "client/src/components/navigation/UnifiedTopBar.tsx",
      "status": "active",
      "design": "Aurora Tide (cyan gradient header)"
    },
    "BottomNav": {
      "path": "@/components/layout/BottomNav",
      "file": "client/src/components/layout/BottomNav.tsx",
      "status": "active",
      "design": "Aurora Tide (mobile 56px touch targets)"
    },
    "Card": {
      "path": "@/components/ui/card",
      "file": "client/src/components/ui/card.tsx",
      "status": "active",
      "design": "Glassmorphic with backdrop-blur"
    },
    "Button": {
      "path": "@/components/ui/button",
      "file": "client/src/components/ui/button.tsx",
      "status": "active",
      "wcag": "min-h-[44px] required"
    }
  },
  
  "deprecated_components": {
    "Sidebar_OLD": {
      "path": "@/components/Sidebar",
      "file": "client/src/components/Sidebar.tsx",
      "status": "deprecated",
      "reason": "Does not use Aurora Tide design system",
      "migrate_to": "@/components/layout/sidebar",
      "migration_notes": "Replace import and update props: setIsOpen instead of onToggle"
    }
  },
  
  "validation_rules": {
    "import_check": {
      "enabled": true,
      "fail_on_deprecated": true,
      "warning_message": "⚠️  Using deprecated component. Migrate to canonical path."
    },
    "aurora_tide_compliance": {
      "required_classes": [
        "from-cyan-50",
        "via-turquoise-50",
        "to-cyan-100",
        "backdrop-blur-xl"
      ]
    },
    "wcag_compliance": {
      "touch_targets": "min-h-[44px] min-w-[44px]",
      "mobile_targets": "min-h-[56px] min-w-[56px]"
    }
  }
}
