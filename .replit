modules = ["nodejs-20", "postgresql-16"]

[agent]
expertMode = true
integrations = ["javascript_object_storage:1.0.0"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 38763
externalPort = 3001

[[ports]]
localPort = 45531
externalPort = 3000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "autoscale"
run = ["npm", "run", "start"]
build = ["npm", "run", "build"]
