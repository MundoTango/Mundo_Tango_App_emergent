modules = ["nodejs-20", "postgresql-16"]

[agent]
expertMode = true
integrations = ["javascript_object_storage:1.0.0", "javascript_log_in_with_replit:1.0.0", "javascript_stripe:1.0.0", "javascript_anthropic:1.0.0"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 34105
externalPort = 3003

[[ports]]
localPort = 36219
externalPort = 5000

[[ports]]
localPort = 37957
externalPort = 3002

[[ports]]
localPort = 38437
externalPort = 5173

[[ports]]
localPort = 38763
externalPort = 3001

[[ports]]
localPort = 42329
externalPort = 4200

[[ports]]
localPort = 42497
externalPort = 6000

[[ports]]
localPort = 43207
externalPort = 8000

[[ports]]
localPort = 44909
externalPort = 8008

[[ports]]
localPort = 45215
externalPort = 6800

[[ports]]
localPort = 45531
externalPort = 3000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[nix]
channel = "stable-25_05"
packages = ["glib", "nss", "nspr", "atk", "at-spi2-atk", "cups", "dbus", "libdrm", "gtk3", "pango", "cairo", "libxkbcommon", "mesa", "libgbm"]

[deployment]
deploymentTarget = "autoscale"
run = ["npm", "start"]
build = ["npm", "run", "build"]
