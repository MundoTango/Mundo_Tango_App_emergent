# TRACK 5 (S5): Backend Dockerfile for Mundo Tango
# Multi-stage build for optimized Node.js server

# Stage 1: Build
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY . .

# Build backend (esbuild compiles server code)
ENV NODE_OPTIONS="--max-old-space-size=1024"
RUN npx esbuild server/index-novite.ts --platform=node --packages=external --external:vite --external:./vite --external:../vite.config --bundle --format=esm --outfile=dist/index.js
RUN cp vite.config.ts dist/vite.config.ts 2>/dev/null || true

# Stage 2: Production
FROM node:20-alpine

WORKDIR /app

# Install production dependencies only
COPY package*.json ./
RUN npm ci --omit=dev

# Copy built backend and dependencies
COPY --from=builder /app/dist ./dist
# Copy shared types (needed for runtime)
COPY --from=builder /app/shared ./shared

# Expose port 5000
EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://localhost:5000/api/health', (r) => r.statusCode === 200 ? process.exit(0) : process.exit(1))"

# Start server
CMD ["npm", "start"]
